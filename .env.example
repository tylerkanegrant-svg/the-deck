EBAY_CLIENT_ID=your-ebay-app-client-id-here
EBAY_CLIENT_SECRET=your-ebay-app-client-secret-here

# Any long random string - used to sign login session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# From https://api.psacard.com - used to look up a graded card directly by
# its cert number instead of guessing the card from scanned label text.
PSA_API_TOKEN=your-psa-api-token-here

# From CardSight AI - used for real sold-price data (eBay's API only gives
# active/asking listings, not confirmed sales).
CARDSIGHT_API_KEY=your-cardsight-api-key-here

# Recommended for real use: a free Turso (libSQL) database, so accounts
# survive a redeploy/restart on hosts (like Render's free plan) that don't
# offer a persistent disk. From https://turso.tech - see the setup steps
# shared alongside this file for exactly how to get these two values.
# Leave both unset for local development - the app then just uses a local
# SQLite file (DATA_DB_PATH below, or "data.db" by default) instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional, local development only - where the local SQLite file (used
# when TURSO_DATABASE_URL is NOT set) lives. Defaults to "data.db" in this
# app's own folder. Not used at all once Turso is configured above.
DATA_DB_PATH=
